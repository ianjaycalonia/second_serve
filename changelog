<!-- Search Box Function -->
function ensureSearchBox() present const bar = document.querySelector("main >
.d-flex"); if (!bar) return; if
(document.getElementById("searchInventoryInput")) return; const wrapper =
document.createElement("div"); wrapper.className = "ms-auto"; wrapper.innerHTML
= '<input
  id="searchInventoryInput"
  class="form-control form-control-sm"
  placeholder="Search items or category"
/>'; bar.appendChild(wrapper);

